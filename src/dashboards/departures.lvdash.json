{
  "datasets": [
    {
      "name": "ds_departures",
      "displayName": "Tram departures",
      "queryLines": [
        "SELECT d.operating_day, d.route, d.direction, d.route_name, d.stop_id, d.stop_name,\n",
        "       d.stop_lat, d.stop_long, d.departed_at_local,\n",
        "       date_trunc('HOUR', d.departed_at_local) AS hour_local,\n",
        "       d.lateness_s,\n",
        "       CASE WHEN d.lateness_s BETWEEN :early_s AND :late_s THEN 'On-time' ELSE 'Not on-time' END AS status,\n",
        "       CASE WHEN d.lateness_s BETWEEN :early_s AND :late_s THEN 1 ELSE 0 END AS on_time\n",
        "FROM gold_departures d\n"
      ],
      "parameters": [
        {
          "keyword": "early_s",
          "displayName": "early_s",
          "dataType": "INTEGER",
          "defaultSelection": {
            "values": {
              "dataType": "INTEGER",
              "values": [
                {
                  "value": "-60"
                }
              ]
            }
          }
        },
        {
          "keyword": "late_s",
          "displayName": "late_s",
          "dataType": "INTEGER",
          "defaultSelection": {
            "values": {
              "dataType": "INTEGER",
              "values": [
                {
                  "value": "180"
                }
              ]
            }
          }
        }
      ],
      "columns": [
        {
          "displayName": "Punctuality",
          "description": "Share of departures inside the On-time window; unknown Lateness counts as not on-time.",
          "expression": "AVG(`on_time`)"
        }
      ]
    },
    {
      "name": "ds_coverage",
      "displayName": "Coverage per Operating Day",
      "queryLines": [
        "WITH m AS (\n",
        "  SELECT to_date(timestampadd(MINUTE, -270, from_utc_timestamp(c.minute_start, 'Europe/Helsinki'))) AS operating_day,\n",
        "         c.covered_s\n",
        "  FROM gold_coverage_minutely c\n",
        ")\n",
        "SELECT m.operating_day,\n",
        "       sum(m.covered_s) AS covered_s,\n",
        "       max(unix_timestamp(least(current_timestamp(),\n",
        "             to_utc_timestamp(timestampadd(MINUTE, 270, timestamp(date_add(m.operating_day, 1))), 'Europe/Helsinki')))\n",
        "           - unix_timestamp(to_utc_timestamp(timestampadd(MINUTE, 270, timestamp(m.operating_day)), 'Europe/Helsinki'))) AS window_s\n",
        "FROM m\n",
        "GROUP BY m.operating_day\n"
      ],
      "columns": [
        {
          "displayName": "Coverage",
          "description": "Share of the selected Operating Days recorded by an Ingestion Session.",
          "expression": "SUM(`covered_s`) / SUM(`window_s`)"
        }
      ]
    }
  ],
